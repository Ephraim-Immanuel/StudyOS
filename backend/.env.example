# Copy this file to ".env" and adjust. NEVER commit ".env".
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://studyos:studyos@localhost:5432/studyos

# Which browser origins may call the API (comma separated).
CORS_ORIGINS=http://localhost:5173

# Session cookie settings. In production (HTTPS) set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_EXPIRE_DAYS=7

# Used when a user's timezone is not provided at registration.
DEFAULT_TIMEZONE=Asia/Kolkata
